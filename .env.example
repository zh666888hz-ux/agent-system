# ============================================================
# 环境变量模板：复制为 .env 后按实际情况填写
# 所有配置项必须以 AGENT_ 前缀命名（见 config/settings.py 的 env_prefix）
# ============================================================

# ---------- LLM（OpenAI 兼容网关） ----------
# 任意 OpenAI 兼容服务均可：DeepSeek / OpenAI / 通义 / vLLM / OneAPI 等
AGENT_OPENAI_BASE_URL=https://api.deepseek.com/v1
AGENT_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
AGENT_CHAT_MODEL=deepseek-chat
AGENT_LLM_TIMEOUT=60
AGENT_LLM_MAX_RETRIES=3
AGENT_LLM_TEMPERATURE=0.0

# ---------- Agent 运行参数 ----------
AGENT_MAX_ITERATIONS=8

# ---------- LLM 调用限流与计量 ----------
# 每分钟最大调用次数 / 每分钟最大 token 消耗（令牌桶，估算预扣+实际结算）
AGENT_LLM_RATE_LIMIT_RPM=60
AGENT_LLM_RATE_LIMIT_TPM=100000
# 限流等待超时（秒）：超过则放弃本次调用
AGENT_LLM_RATE_LIMIT_TIMEOUT=10
# 令牌桶突发窗口（秒）：桶容量=每秒速率×窗口，允许突发同时限制长期均值
AGENT_LLM_RATE_LIMIT_BURST_SECONDS=30

# ---------- HTTP API 服务（serve.py） ----------
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8000
# 每个客户端 IP 每分钟最大请求数 / 令牌桶突发容量
AGENT_API_RATE_LIMIT_RPM=30
AGENT_API_RATE_LIMIT_BURST=10

# ---------- 工具：失败自动重试 ----------
# 工具调用失败后自动重试次数（连续失败超过该值则终止任务并友好提示）
AGENT_TOOL_MAX_RETRIES=2
# 重试指数退避基数（秒）：首次等待 1s，之后 2s、4s ... 翻倍
AGENT_TOOL_RETRY_BACKOFF=1.0

# ---------- 记忆系统（短期会话记忆 + 长期跨会话记忆） ----------
AGENT_MEMORY_ENABLED=true
AGENT_MEMORY_DB_PATH=memory.db
# 是否在每轮对话后用 LLM 提炼长期记忆（关闭可省 token）
AGENT_MEMORY_EXTRACT=true
# 每次注入 Agent 上下文的长期记忆条数上限
AGENT_MEMORY_INJECT_LIMIT=20

# ---------- 工具：网络搜索 ----------
# bing（默认，国内可达）/ wikipedia / duckduckgo（海外环境）
AGENT_SEARCH_ENGINE=bing
AGENT_SEARCH_TOP_K=5
AGENT_SEARCH_TIMEOUT=15

# ---------- 工具：文档总结 ----------
AGENT_SUMMARY_MAX_TOKENS=500
AGENT_SUMMARY_MAX_CHARS=8000

# ---------- 日志 ----------
AGENT_LOG_LEVEL=INFO
AGENT_LOG_DIR=logs
