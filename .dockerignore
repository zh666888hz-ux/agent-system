# ============================================================
# .dockerignore：排除敏感信息与本地产物，避免打进镜像
# ============================================================

# 敏感信息（绝不进镜像）
.env
*.pem
*.key

# Python 缓存与虚拟环境
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# 日志与本地临时产物
logs/
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db

# 容器/编排文件（无需进入应用镜像）
Dockerfile
.dockerignore
