# ============================================================
# .gitignore：敏感信息与临时产物不入库
# ============================================================

# ---- 敏感信息（绝不提交）----
.env

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 日志与临时文件 ----
logs/
*.log
.DS_Store
Thumbs.db

# ---- 本地测试产物 ----
*.tmp
*.bak
